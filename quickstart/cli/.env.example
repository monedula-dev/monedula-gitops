# DEMO ONLY -- fake credentials.
#
# The tool connects as the SCRAM super-user `admin`: it manages topics AND ACLs,
# so it must bypass ACL enforcement. (An app user like `monedula` would lock
# itself out the moment `apply` creates ACLs on a topic: with
# allow.everyone.if.no.acl.found=true, a resource is open only while it has NO
# ACLs -- once the manifest's ACLs exist, any principal not listed loses access.)
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_USERNAME=admin
KAFKA_PASSWORD=admin-secret
SCHEMA_REGISTRY_URL=http://localhost:8081
SR_USERNAME=sr
SR_PASSWORD=sr-secret
